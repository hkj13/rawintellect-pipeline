        "highlight": 0
      },
      "emphasis": [
        "six",
        "thousand"
      ]
    },
    {
      "text": "Its T-shaped pillars are the oldest known megaliths in the world.",
      "visual": {
        "type": "words",
        "words": [
          "oldest",
          "megaliths"
        ]
      },
      "emphasis": [
        "oldest"
      ]
    },
    {
      "text": "They're carved with snakes, foxes, boars, and vultures.",
      "visual": {
        "type": "icon",
        "names": [
          "bug",
          "star"
        ],
        "label": "snakes, foxes, boars, vultures"
      },
      "emphasis": [
        "snakes,",
        "vultures."
      ]
    },
    {
      "text": "And it was built by hunter-gatherers, before pottery, before cities.",
      "visual": {
        "type": "words",
